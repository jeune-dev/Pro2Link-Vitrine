# ─────────────────────────────────────────────────────────────────────────────
# Pro2Link Site — variables d'environnement (préfixe VITE_ : PUBLIQUES, incluses
# dans le bundle livré au navigateur). N'y mettez JAMAIS de secret.
# Copier en .env.development.local (dev) ou .env.production.local (build).
# ─────────────────────────────────────────────────────────────────────────────

# URL de base de l'API (préfixe réel du backend : /api/v1).
# - Développement : laisser /api/v1, le proxy Vite redirige vers le backend.
# - Production : même domaine derrière un reverse proxy (/api/v1) ou URL complète,
#   ex. https://api.pro2link.sn/api/v1 (le site doit alors figurer dans CORS_ORIGIN
#   du backend et partager le même domaine principal : cookie SameSite=Strict).
VITE_API_BASE_URL=/api/v1

# Développement uniquement : backend vers lequel le proxy Vite redirige /api et /health.
VITE_API_PROXY_TARGET=http://localhost:3000

# URL de l'application web des entreprises (acheteurs / fournisseurs).
# Un compte entreprise qui se connecte ou s'inscrit sur ce site y est redirigé.
# Vide : une page explique où retrouver son espace.
VITE_APP_ENTREPRISE_URL=

# URL du back-office des administrateurs (application distincte pro2link-admin).
# Un super admin qui se connecte sur le site y est renvoyé. Vide : lien masqué.
VITE_ADMIN_URL=

# URL publique du site vitrine (balises canoniques, Open Graph, sitemap.xml).
# Vide : pas de sitemap généré et pas de balise canonique.
VITE_SITE_URL=

# Coordonnées affichées dans le pied de page et la page de contact (facultatif).
# Vide : la rubrique contact n'est pas affichée (aucune coordonnée inventée).
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
